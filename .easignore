# EAS Build yuklamasi (M-A8). EAS CLI bu faylni .gitignore O'RNIGA ishlatadi — .gitignore qoidalari shu yerda ham.
node_modules/
dist/
coverage/
*.log
.env
.env.local
.DS_Store
Thumbs.db
mock/fixtures/glb/
mock/fixtures/qr/
apps/mobile/.expo/
