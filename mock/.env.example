# Nusxa oling: .env (commit qilinmaydi)
HOST=0.0.0.0
PORT=8787
# Juftlashsiz ishlatiladigan doimiy token (viewer dev, curl). Faqat mock uchun.
MOCK_DEV_TOKEN=dev-token
# POST /mobile/ar-link imzolangan havolasi uchun HMAC kaliti.
MOCK_SIGN_SECRET=dev-sign-secret
# Tashqi HTTPS manzil (cloudflared tunnel) — AR havolalari shu bilan yasaladi. Bo'sh: so'rovdagi host.
MOCK_PUBLIC_URL=
