{
  "name": "hub-mobile",
  "private": true,
  "description": "U-HUB mobil viewer: Expo ilova, three.js viewer, mock API (kontrakt uhub-mobile/1.1)",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "mock",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "fixtures": "npm run generate -w @hub-mobile/sample-glb && npm run qr -w @hub-mobile/mock",
    "mock": "npm run dev -w @hub-mobile/mock"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
